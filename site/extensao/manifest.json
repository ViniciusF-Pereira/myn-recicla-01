{
  "manifest_version": 3,
  "name": "Myn Recicla/01 — VM Web",
  "version": "1.3.1",
  "description": "Abre a VM Web do Myn e conecta rotas de abas gratuitas ao seu navegador, com permissão por site.",
  "permissions": ["storage", "tabs", "scripting", "sidePanel", "activeTab"],
  "host_permissions": [
    "https://mynrecicla.com/*",
    "http://127.0.0.1:5188/*"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://huggingface.co/*",
    "https://openrouter.ai/*",
    "https://chat.z.ai/*",
    "https://www.perplexity.ai/*",
    "https://copilot.com/*",
    "https://chat.mistral.ai/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://www.meta.ai/*",
    "https://pi.ai/*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://duck.ai/*",
    "https://www.blackbox.ai/*",
    "https://www.t3.chat/*",
    "https://search.brave.com/*",
    "https://www.ecosia.org/*",
    "https://www.phind.com/*",
    "https://writesonic.com/*",
    "https://hix.ai/*",
    "https://playground.ai.cloudflare.com/*",
    "https://chat.webllm.ai/*",
    "https://plai.chat/*",
    "https://uncensoredllm.ai/*",
    "https://rewind.ai/*",
    "https://ngini.com/*",
    "https://uncensored.chat/*",
    "https://playground.allenai.org/*",
    "https://nofiltergpt.com/*",
    "https://www.americanas.com.br/*",
    "https://www.magazineluiza.com.br/*",
    "https://www.casasbahia.com.br/*",
    "https://www.lojasrenner.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://www.shopee.com.br/*",
    "https://www.amazon.com.br/*",
    "https://www.submarino.com.br/*",
    "https://www.extra.com.br/*",
    "https://www.pontofrio.com.br/*",
    "https://www.centauro.com.br/*",
    "https://www.netshoes.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir VM Web do Myn",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mynrecicla.com/*",
        "http://127.0.0.1:5188/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
