<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Myn — Recyla/01 · caderno de campo</title>
<meta name="description" content="Abas de IA gratuitas recicladas como rotas de agente. Playground com chat, loop, RAG e历史 automático.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500;1,6..72,600&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
 --papel:#f2ecdd;--papel2:#e9e0cc;--card:#fbf7ec;--tinta:#22251f;--navy:#1d2233;
 --mostarda:#c68b2c;--mostarda-cl:#e2b866;--verde:#3c6b52;--linha:#bfb59e;--mut:#6d6759;
 --serif:"Newsreader",Georgia,serif;--mono:"IBM Plex Mono",ui-monospace,monospace;--sans:"IBM Plex Sans",system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
 margin:0;color:var(--tinta);font:16px/1.65 var(--serif);
 background-color:var(--papel);
 background-image:
  repeating-linear-gradient(0deg,rgba(34,37,31,.016) 0 1px,transparent 1px 4px),
  repeating-linear-gradient(90deg,rgba(34,37,31,.010) 0 1px,transparent 1px 8px),
  radial-gradient(circle at 92% 4%,rgba(198,139,44,.10),transparent 24%);
}
a{color:var(--verde);text-decoration:none;border-bottom:1px solid rgba(60,107,82,.35)}
a:hover{border-color:var(--verde);background:rgba(60,107,82,.07)}
.wrap{max-width:1160px;margin:auto;padding:0 24px}
.ico{width:18px;height:18px;display:inline-block;vertical-align:-4px;stroke:currentColor;fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* cabeçalho de caderno */
header{position:sticky;top:0;z-index:60;background:rgba(242,236,221,.93);backdrop-filter:blur(8px);border-bottom:1px solid var(--tinta)}
.head{display:flex;align-items:center;gap:14px;padding:10px 0}
.logo{display:flex;align-items:center;gap:9px;color:inherit;border:0;background:none}
.logo .stampa{width:36px;height:36px;border:1.4px solid var(--tinta);border-radius:3px;display:grid;place-items:center;background:var(--card);box-shadow:2px 2px 0 var(--mostarda)}
.logo .stampa svg{width:22px;height:22px;stroke:var(--tinta)}
.logo b{font:600 .95rem var(--sans);letter-spacing:.02em}
.logo b em{font:italic 500 .95rem var(--serif);color:var(--mostarda)}
nav{display:flex;gap:4px;margin-left:auto;flex-wrap:wrap}
nav a{font:600 .66rem var(--mono);text-transform:uppercase;letter-spacing:.1em;color:var(--mut);border:0;padding:7px 9px;position:relative}
nav a:hover{color:var(--tinta);background:transparent}
nav a:hover:after{content:"";position:absolute;left:8px;right:8px;bottom:3px;border-bottom:1px solid var(--mostarda)}
.selo{font:600 .6rem var(--mono);text-transform:uppercase;letter-spacing:.1em;border:1px solid var(--tinta);padding:5px 8px;border-radius:2px;background:var(--mostarda-cl);box-shadow:2px 2px 0 var(--tinta)}

/* herói */
.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;padding:60px 0 46px;border-bottom:1px solid var(--linha)}
.eyebrow{display:flex;align-items:center;gap:10px;font:600 .65rem var(--mono);text-transform:uppercase;letter-spacing:.15em;color:var(--verde)}
.eyebrow:before{content:"";width:30px;border-top:1px solid var(--verde)}
h1{font:italic 500 clamp(2.7rem,5.6vw,4.7rem)/.98 var(--serif);letter-spacing:-.035em;margin:20px 0 18px}
h1 span{color:var(--mostarda);font-style:normal;border-bottom:3px solid var(--mostarda-cl)}
.lede{font-size:1.1rem;max-width:56ch;color:#3d4139}
.lede strong{font-weight:500;color:var(--tinta);border-bottom:1px dotted var(--mostarda)}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin:22px 0 4px}
.chip{font:500 .63rem var(--mono);letter-spacing:.03em;border:1px solid var(--linha);padding:5px 9px;border-radius:2px;background:var(--card);display:inline-flex;gap:6px;align-items:center}
.chip.m{border-color:var(--mostarda);background:rgba(198,139,44,.10)}
.btn{font:600 .7rem var(--mono);text-transform:uppercase;letter-spacing:.1em;border:1.4px solid var(--tinta);background:var(--navy);color:#f6f0e2;padding:12px 17px;border-radius:2px;cursor:pointer;box-shadow:3px 3px 0 var(--mostarda);display:inline-flex;align-items:center;gap:9px;transition:transform .12s,box-shadow .12s}
.btn:hover{transform:translate(-1px,-1px);box-shadow:4px 4px 0 var(--mostarda)}
.btn:active{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--mostarda)}
.btn:disabled{opacity:.55;cursor:wait}
.btn.sec{background:var(--card);color:var(--tinta);box-shadow:3px 3px 0 var(--linha)}
.btn .ico{width:16px;height:16px}

/* figura */
.figura{margin:0}
.quadro{position:relative;border:1.2px solid var(--tinta);background:var(--card);padding:6px;box-shadow:6px 7px 0 rgba(29,34,51,.10)}
.quadro:before,.quadro:after{content:"";position:absolute;width:13px;height:13px;border-color:var(--mostarda);border-style:solid}
.quadro:before{top:-4px;left:-4px;border-width:2px 0 0 2px}
.quadro:after{bottom:-4px;right:-4px;border-width:0 2px 2px 0}
.quadro svg.arte{display:block;width:100%;height:auto;border:1px solid var(--linha)}
.figcap{font:italic .86rem var(--serif);color:var(--mut);margin:12px 0 0;padding-left:12px;border-left:2px solid var(--mostarda)}
.figcap b{font:600 .65rem var(--mono);font-style:normal;color:var(--mostarda);letter-spacing:.08em;text-transform:uppercase}

/* ledger */
.ledger{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--tinta);background:var(--card);margin:0 0 8px}
.ledger div{padding:14px 16px;border-right:1px solid var(--linha);position:relative}
.ledger div:last-child{border-right:0}
.ledger b{display:block;font:500 1.85rem/1 var(--serif);color:var(--navy)}
.ledger small{font:600 .6rem var(--mono);text-transform:uppercase;letter-spacing:.1em;color:var(--mut)}
.ledger div:nth-child(2) b{color:var(--mostarda)}
.rabisco{position:absolute;right:-6px;bottom:-9px;width:34px;height:18px;pointer-events:none}

/* seções */
section{padding:50px 0;border-bottom:1px solid var(--linha);scroll-margin-top:64px}
.st{display:flex;align-items:flex-start;gap:16px;margin-bottom:8px}
.st .num{font:600 2.1rem/1 var(--serif);color:var(--mostarda);border:1px solid var(--mostarda);padding:4px 9px;border-radius:2px;background:rgba(198,139,44,.07)}
.st h2{font:italic 500 clamp(1.9rem,3.4vw,2.7rem)/1.05 var(--serif);letter-spacing:-.02em;margin:2px 0 0}
.st .traco{flex:1;border-top:1px dashed var(--linha);margin-top:24px}
.sub{color:var(--mut);max-width:78ch;margin:6px 0 22px;font-size:1rem}
.nota{margin-left:auto;font:italic .8rem var(--serif);color:var(--mostarda);white-space:nowrap}

/* playground */
#playground{display:none}
#playground.aberto{display:block}
.play{display:grid;grid-template-columns:262px 1fr;border:1.2px solid var(--tinta);background:var(--card);box-shadow:7px 8px 0 rgba(29,34,51,.10)}
.playleft{background:var(--papel2);border-right:1px solid var(--tinta);padding:16px;display:flex;flex-direction:column;gap:12px;position:relative}
.playleft:after{content:"";position:absolute;inset:5px;border:1px dashed var(--linha);pointer-events:none}
.topo{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--tinta);padding-bottom:9px;position:relative;z-index:1}
.topo b{font:600 .74rem var(--mono);letter-spacing:.06em}
.ponto{width:9px;height:9px;border-radius:50%;background:var(--mostarda);border:1px solid var(--tinta);box-shadow:0 0 0 3px rgba(198,139,44,.22)}
.modos{display:flex;flex-direction:column;gap:6px;position:relative;z-index:1}
.modo{text-align:left;border:1px solid var(--linha);background:var(--card);border-radius:2px;padding:9px 10px 9px 34px;cursor:pointer;position:relative;font:500 .9rem var(--serif);color:var(--tinta)}
.modo:before{content:attr(data-n);position:absolute;left:8px;top:9px;font:600 .62rem var(--mono);color:var(--mostarda)}
.modo small{display:block;font:500 .61rem var(--mono);color:var(--mut);margin-top:2px;letter-spacing:.01em}
.modo .ico{position:absolute;right:9px;top:10px;width:15px;height:15px;color:var(--linha)}
.modo:hover{border-color:var(--verde)}
.modo.on{background:var(--navy);border-color:var(--tinta);color:#f6f0e2;box-shadow:3px 3px 0 var(--mostarda)}
.modo.on:before,.modo.on .ico{color:var(--mostarda-cl)}
.modo.on small{color:#b9c4bd}
.playleft label{font:600 .6rem var(--mono);text-transform:uppercase;letter-spacing:.12em;color:var(--mut);position:relative;z-index:1}
.playleft select{width:100%;padding:9px;background:var(--card);border:1px solid var(--tinta);border-radius:2px;font:500 .72rem var(--mono);color:var(--tinta);position:relative;z-index:1}
.status{margin-top:auto;border:1px dashed var(--mostarda);background:rgba(198,139,44,.09);padding:9px 10px;font:500 .65rem var(--mono);color:#6b4d15;position:relative;z-index:1;min-height:44px}
.status:before{content:"✎ ";color:var(--mostarda)}
.playmain{padding:20px 22px;min-width:0;position:relative}
.playmain:before{content:"";position:absolute;left:0;top:0;bottom:0;width:18px;background:repeating-linear-gradient(90deg,transparent 0 7px,rgba(34,37,31,.06) 7px 8px);pointer-events:none}
.tela{display:none}
.tela.on{display:block}
.tela h3{font:italic 500 1.55rem var(--serif);margin:0 0 4px}
.form{display:flex;gap:9px;align-items:flex-end;flex-wrap:wrap;margin:12px 0}
.form textarea,.form input{font:400 .92rem var(--serif);color:var(--tinta);background:var(--card);border:1px solid var(--linha);border-bottom:1.4px solid var(--tinta);border-radius:2px;padding:11px;outline:none}
.form textarea:focus,.form input:focus{border-color:var(--mostarda);background:#fffdf4}
.form textarea{flex:1;min-width:210px;min-height:52px;max-height:130px;resize:vertical}
.form input{flex:1;min-width:200px}
.msgs{height:318px;overflow:auto;display:flex;flex-direction:column;gap:10px;padding:10px 12px;border:1px dashed var(--linha);background:rgba(251,247,236,.6)}
.msg{max-width:82%;padding:9px 12px;font:.92rem var(--serif);white-space:pre-wrap;overflow-wrap:anywhere;border:1px solid var(--linha);background:var(--card)}
.msg.eu{align-self:flex-end;background:var(--navy);color:#f6f0e2;border-color:var(--tinta)}
.msg.ele{align-self:flex-start;border-left:3px solid var(--mostarda)}
.msg.err{align-self:center;background:#f6ded0;color:#7a2b16;border-color:#b4512e;font:.78rem var(--mono)}
.trilha{margin-top:12px;border-top:1px dashed var(--linha);padding-top:10px;max-height:270px;overflow:auto;background:repeating-linear-gradient(180deg,transparent 0 26px,rgba(34,37,31,.035) 26px 27px)}
.passo-linha{font:.78rem/1.5 var(--mono);color:#454a41;padding:5px 4px;border-bottom:1px dotted var(--linha)}
.fonte{font:.75rem/1.5 var(--mono);color:var(--verde);padding:6px 4px;border-bottom:1px dotted var(--linha);word-break:break-all}
.fonte:before{content:"↳ ";color:var(--mostarda)}
.aviso{background:rgba(198,139,44,.10);border:1px dashed var(--mostarda);padding:10px 13px;font:.82rem var(--serif);margin-top:14px}
.aviso b{font:600 .65rem var(--mono);text-transform:uppercase;letter-spacing:.08em;color:var(--mostarda)}

/* grade de fichas */
.filtros{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.filtros .aba{font:600 .64rem var(--mono);text-transform:uppercase;letter-spacing:.07em;border:1px solid var(--linha);background:var(--card);padding:6px 10px;border-radius:2px;cursor:pointer;color:var(--mut)}
.filtros .aba.on{background:var(--mostarda-cl);border-color:var(--tinta);color:var(--tinta);box-shadow:2px 2px 0 var(--tinta)}
.grade{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
.card{background:var(--card);border:1px solid var(--linha);border-radius:2px;padding:14px 15px;position:relative;box-shadow:3px 4px 0 rgba(34,37,31,.06)}
.card:before{content:"";position:absolute;top:5px;right:5px;width:9px;height:9px;border-top:1px solid var(--mostarda);border-right:1px solid var(--mostarda)}
.card h3{margin:0 0 6px;font:500 1.05rem var(--serif)}
.card p{font-size:.9rem;color:#4a4e45;margin:.35em 0}
.card .ico{color:var(--mostarda);width:20px;height:20px;margin-right:6px}
.card a{font:500 .7rem var(--mono);word-break:break-all}
.tag{font:500 .6rem var(--mono);border:1px solid var(--linha);padding:2px 6px;border-radius:2px;background:var(--papel)}
.tag.m{border-color:var(--verde);color:var(--verde)}
.lista-limite{max-height:520px;overflow:auto;padding-right:6px}

/* passos do ciclo */
.passos{display:grid;gap:0;position:relative}
.passo{display:grid;grid-template-columns:56px 1fr;gap:14px;padding:12px 0;border-bottom:1px dashed var(--linha);position:relative}
.passo .n{font:600 1.7rem var(--serif);color:var(--mostarda);text-align:center;border-right:1px solid var(--linha)}
.passo b{font:500 1.05rem var(--serif)}
.passo p{margin:2px 0 0;color:var(--mut);font-size:.93rem}
.passo .ico{position:absolute;right:4px;top:16px;color:var(--linha);width:24px;height:24px}
.colofone{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap}
.colofone .card{flex:1;min-width:210px}
footer{padding:28px 0 50px;color:var(--mut);font:.72rem var(--mono);display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;align-items:center}
.cc{border:1px solid var(--tinta);border-radius:50%;width:28px;height:28px;display:grid;place-items:center;font:600 .7rem var(--serif);box-shadow:2px 2px 0 var(--mostarda)}
@media(max-width:860px){.hero{grid-template-columns:1fr;gap:28px}.quadro{max-width:400px;margin:auto}nav{display:none}.play{grid-template-columns:1fr}.playleft{border-right:0;border-bottom:1px solid var(--tinta)}.modos{flex-direction:row;overflow:auto}.modo{white-space:nowrap;min-width:170px}.status{margin-top:0}.ledger{grid-template-columns:repeat(2,1fr)}.ledger div:nth-child(2){border-right:0}.nota{display:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn:hover{transform:none}}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
 <symbol id="i-recycle" viewBox="0 0 24 24"><path d="M12 3.2l2.6 4.5-2.1.1M9.4 3.2 6.8 7.7l2.1.1M20 11.4l-4.4 1.6.6-2M4 11.4l4.4 1.6-.6-2M7 20h3.4l1.6-2.8 1.6 2.8H17M7.6 14.2 4 11.4l2.4-4.6M16.4 14.2 20 11.4l-2.4-4.6"/></symbol>
 <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13.5 2 5 13h6l-1 9 9-12h-6z"/></symbol>
 <symbol id="i-chat" viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/></symbol>
 <symbol id="i-loop" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-3-6.2M20 4v5h-5"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/></symbol>
 <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5M8 10.5h5"/></symbol>
 <symbol id="i-history" viewBox="0 0 24 24"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1M3.5 4v4.5H8"/><path d="M12 7v5l3.5 2"/></symbol>
 <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M20 4C10 4 4 9 4 16c0 2 1 4 1 4s2-6 9-9c-4 3-6 6-6 9 0 0 12 1 12-16z"/><path d="M4 20c3-5 7-8 12-10"/></symbol>
 <symbol id="i-file" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></symbol>
 <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></symbol>
 <symbol id="i-jar" viewBox="0 0 24 24"><path d="M8 3h8M9 3v3h6V3M7 7h10v13H7z"/><path d="M11 11h2M12 9v6"/></symbol>
 <symbol id="i-cat" viewBox="0 0 24 24"><path d="M6 10 5 4l4 3a8 8 0 0 1 6 0l4-3-1 6a7 7 0 0 1 1 4c0 4-3 6-7 6s-7-2-7-6a7 7 0 0 1 1-4z"/><circle cx="9.5" cy="13" r=".9" fill="currentColor" stroke="none"/><circle cx="14.5" cy="13" r=".9" fill="currentColor" stroke="none"/><path d="m11 16 1 1 1-1M7 16h2.5M14.5 16H17"/></symbol>
 <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15M14 7l5 5-5 5"/></symbol>
 <symbol id="i-web" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></symbol>
 <symbol id="i-video" viewBox="0 0 24 24"><rect x="3" y="6" width="13" height="12" rx="1"/><path d="m16 10 5-3v10l-5-3z"/></symbol>
 <symbol id="i-sound" viewBox="0 0 24 24"><path d="M4 10h3l4-4v12l-4-4H4zM15 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12"/></symbol>
 <symbol id="i-api" viewBox="0 0 24 24"><path d="M8 7 3 12l5 5M16 7l5 5-5 5M14 4l-4 16"/></symbol>
 </defs></svg>

<header><div class="wrap head">
 <a class="logo" href="#topo"><span class="stampa"><svg><use href="#i-recycle"/></svg></span><b>Myn <em>Recyla/01</em></b></a>
 <nav><a href="#catalogo">catálogo</a><a href="#extras">extras</a><a href="#como">ciclo</a><a href="#sobre">sobre</a></nav>
 <span class="selo">♻ browser only</span>
</div></header>

<main class="wrap" id="topo">

<section class="hero" style="border-bottom:1px solid var(--linha)">
 <div>
  <div class="eyebrow">caderno de campo · resíduo digital → insumo de agente</div>
  <h1>IA de graça já existe.<br><span>O Myn recicla.</span></h1>
  <p class="lede">O Recyla/01 transforma abas de chat gratuitas em <strong>rotas reaproveitáveis</strong>. Sem chave de API, sem assinatura, sem Codex — só navegador, gateway mediado e ferramentas com escopo.</p>
  <div class="chips"><span class="chip m"><svg class="ico"><use href="#i-recycle"/></svg> reaproveitável</span><span class="chip"><svg class="ico"><use href="#i-web"/></svg> browser route</span><span class="chip"><svg class="ico"><use href="#i-gear"/></svg> tools validadas</span><span class="chip"><svg class="ico"><use href="#i-loop"/></svg> loop + RAG</span></div>
  <p><button class="btn" id="abrirPlay"><svg class="ico"><use href="#i-arrow"/></svg> ABRIR PLAYGROUND /01</button></p>
 </div>
 <figure class="figura">
  <div class="quadro">
   <svg class="arte" viewBox="0 0 320 230" role="img" aria-label="Ilustração: gato sobre uma duna com sol mostarda e montanhas hachuradas">
    <defs>
     <pattern id=" Sky" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(20)"><line x1="0" y1="0" x2="0" y2="7" stroke="#22251f" stroke-width=".5" opacity=".22"/></pattern>
     <pattern id="Morro" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><line x1="0" y1="0" x2="0" y2="5" stroke="#22251f" stroke-width=".5" opacity=".32"/></pattern>
    </defs>
    <rect x="12" y="12" width="296" height="206" fill="#fbf7ec"/>
    <rect x="12" y="12" width="296" height="206" fill="url(# Sky)"/>
    <path d="M6 30V6h24M314 30V6h-24M6 200v24h24M314 200v24h-24" fill="none" stroke="#c68b2c" stroke-width="1.5"/>
    <g stroke="#c68b2c" stroke-width=".85" opacity=".85"><path d="M160 30v-10M120 41l-6-9M200 41l6-9M94 72l-10-4M226 72l10-4M72 106H60M248 106h12"/></g>
    <circle cx="160" cy="118" r="61" fill="#d99b32" stroke="#22251f" stroke-width="1.1"/>
    <circle cx="160" cy="118" r="54" fill="none" stroke="#f2ecdd" stroke-width=".6" opacity=".55"/>
    <path d="M12 172 58 124 90 158 126 118 160 158 196 116 232 158 268 124 308 172V218H12Z" fill="url(#Morro)" stroke="#22251f" stroke-width="1"/>
    <path d="M12 184c48-11 78 13 128 3s90 12 168-2v33H12z" fill="#1d2233"/>
    <g fill="none" stroke="#c68b2c" stroke-width="1"><path d="M26 214c28-18 46 0 74-12M146 214c28-18 46 0 74-12M248 212c24-14 40 0 58-10"/></g>
    <g fill="#c68b2c"><circle cx="100" cy="202" r="2"/><circle cx="220" cy="202" r="2"/><circle cx="306" cy="202" r="2"/></g>
    <g transform="translate(160 128)">
